# ============================================================
# 发布签名配置模板
#
# 用法：
#   1. 复制本文件为 keystore.properties（去掉 .example 后缀）
#   2. 填入你自己的 keystore 路径与口令
#   3. keystore.properties 已被 .gitignore 排除，不会进版本库
#
# 生成 keystore 的命令见 docs/P6-打包APK.md
# ============================================================

# keystore 文件路径。Windows 上用正斜杠或双反斜杠
storeFile=D:/英语APP开发/release.keystore

# 密钥库口令
storePassword=在这里填你的口令

# 密钥别名（生成时用 -alias 指定）
keyAlias=wordflash

# 密钥口令（PKCS12 格式下通常与 storePassword 相同）
keyPassword=在这里填你的口令
