# ============================================================
# 单词速记 —— .gitignore
# ============================================================

# ---------- 构建产物 ----------
*.iml
.gradle
/build
/app/build
/captures
.externalNativeBuild
.cxx
*.hprof

# ---------- 本地配置（含机器专属路径，不入库）----------
local.properties
/local.properties

# ---------- IDE ----------
/.idea

# ============================================================
# 签名与密钥 —— 绝不能提交到版本库
#
# 一旦泄露，任何人都能用你的身份签名 APK；
# 一旦丢失，你将永远无法更新已发布的应用。
# ============================================================
*.keystore
*.jks
keystore.properties
!debug.keystore

# 密钥备份记录：内含明文口令，必须排除
签名密钥-务必备份.txt
*务必备份*.txt
SIGNING-KEY*.txt

# ---------- 打包产物 ----------
*.apk
*.aab
/app/release

# ---------- 系统 ----------
.DS_Store
Thumbs.db
