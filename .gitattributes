# 统一换行符与文本属性，避免 Windows 上 checkout 时被自动改写。
# 尤其重要：*.ps1 含中文，必须保持 UTF-8 与原始字节，否则
# Windows PowerShell 5.1 会按 GBK 解码而报语法错误。
* text=auto eol=lf

# PowerShell 脚本：保持原样，禁止换行符转换
*.ps1 -text
*.bat -text
*.cmd -text

# 各语言源码
*.kt   text eol=lf
*.java text eol=lf
*.kts  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.py   text eol=lf
*.js   text eol=lf

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.jar  binary
*.keystore binary
*.jks  binary
*.apk  binary
*.aab  binary
